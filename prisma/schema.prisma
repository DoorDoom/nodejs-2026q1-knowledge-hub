// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String      @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  login     String   @unique
  password  String  
  refreshToken String?
  role      Role?     @default(VIEWER)

  articles  Article[] @relation("UserArticles")
  comments  Comment[] @relation("UserComments")
}

model Article {
  id        String      @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String   @db.VarChar(255)
  content   String 
  status    Status?     @default(DRAFT)

  author    User?     @relation("UserArticles",fields: [authorId], references: [id],  onDelete: SetNull)
  authorId  String?

  category    Category?     @relation("CategoryArticles",fields: [categoryId], references: [id],  onDelete: SetNull)
  categoryId  String?

  tags      Tag[]     @relation("ArticleTags")
  comments  Comment[] @relation("ArticleComments")
}

model Category {
  id        String      @id @default(uuid())
  name      String   @db.VarChar(255) @unique
  description     String 

  articles Article[]  @relation("CategoryArticles")
}

model Comment {
  id        String      @id @default(uuid())
  content     String     @db.VarChar(255)

  author    User     @relation("UserComments",fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  article    Article     @relation("ArticleComments",fields: [articleId], references: [id], onDelete: Cascade)
  articleId  String
}

model Tag {
  id        String      @id @default(uuid())
  name     String       @unique
  articles Article[]    @relation("ArticleTags")
}

enum Role {
  EDITOR
  ADMIN
  VIEWER
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
